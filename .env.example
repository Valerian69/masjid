# ============================================
# Masjid Dashboard - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Supabase (get from https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret (generate a random string, e.g. from https://generate-secret.vercel.app/32)
JWT_SECRET=your_random_secret_here

# CORS Origins (comma-separated, e.g. "https://masjid-umber.vercel.app,http://localhost:3001")
CORS_ORIGIN=

# Frontend API URL (only for local dev, Vercel uses /api automatically)
REACT_APP_API_URL=http://localhost:5001/api
