{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/tv-display/build/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/admin-panel/build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/tv/(.*)",
      "dest": "/frontend/tv-display/build/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/frontend/admin-panel/build/index.html"
    },
    {
      "src": "/tv",
      "dest": "/frontend/tv-display/build/index.html"
    },
    {
      "src": "/admin",
      "dest": "/frontend/admin-panel/build/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/tv-display/build/$1"
    }
  ]
}
