{
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/tv/(.*)", "destination": "/tv/index.html" },
    { "source": "/tv", "destination": "/tv/index.html" },
    { "source": "/(.*)", "destination": "/tv/$1" }
  ]
}
