{
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/tv-display/build",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/frontend/admin-panel/build/index.html" },
    { "source": "/admin", "destination": "/frontend/admin-panel/build/index.html" },
    { "source": "/tv/(.*)", "destination": "/frontend/tv-display/build/index.html" },
    { "source": "/tv", "destination": "/frontend/tv-display/build/index.html" },
    { "source": "/(.*)", "destination": "/frontend/tv-display/build/$1" }
  ]
}
